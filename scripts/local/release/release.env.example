# RELEASE stack env: key names and non-secret values only. Tracked file.
#
# The real file is generated ONCE, before the cutover, by `scripts/local/release.ps1 init-env` into the
# gitignored `.local/release/release.env` of the main checkout. init-env copies the current apps/api/.env
# verbatim and overrides the release values below. After the cutover apps/api/.env holds DEBUG values
# and init-env refuses: edit release.env by hand (or restore a .local/release/release.env.bak-* copy).
# release.ps1 passes that file to compose both as `--env-file` (for ${...} interpolation in
# docker-compose.release.yml) and as the backend `env_file`.
# release.ps1 refuses to run unless release.env has every key listed here (it may hold more) and the
# service hosts resolve to plane-db, plane-redis, plane-mq and plane-minio (no debug ports, no
# host.docker.internal).
#
# Secrets must equal the values the volumes were created with:
#   SECRET_KEY            decrypts stored instance settings and signs sessions/invites (plane_pgdata)
#   POSTGRES_*            plane_pgdata was initialised with these
#   RABBITMQ_*            plane_rabbitmq_data was initialised with these
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY   MinIO root credentials of plane_uploads
#   LIVE_SERVER_SECRET_KEY  shared by the api and live containers
# Never change them after cutover.
#
# Never commit real values or private hosts: this fork is public. <PLANE_PUBLIC_HOST> and
# <tailnet-ip> below are placeholders that only ever get real values in .local/release/release.env.
#
# These keys must be ABSENT from release.env:
#   DJANGO_SETTINGS_MODULE  absent => plane.settings.production for api, worker, beat and migrator
#   SESSION_COOKIE_NAME     absent => default `session-id`, so current logins survive the cutover
#
# Keep comments on their own lines; never put a comment after a value on the same line.

# --- Secrets (copied verbatim from apps/api/.env) ---
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# --- Postgres (credentials copied verbatim) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=plane
POSTGRES_HOST=plane-db
POSTGRES_PORT=5432
# Copied verbatim, normally postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# It must come after the POSTGRES_* lines: dotenv expands ${...} from earlier lines.
DATABASE_URL=<copied verbatim>

# --- Redis ---
REDIS_HOST=plane-redis
REDIS_PORT=6379
# Copied verbatim; must resolve to redis://plane-redis:6379/ and come after REDIS_HOST/REDIS_PORT.
REDIS_URL=<copied verbatim>

# --- RabbitMQ (credentials and vhost copied verbatim) ---
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# --- MinIO / S3 (credentials copied verbatim). Server-side calls use the in-network endpoint;
# browsers get presigned same-origin <origin>/uploads/... URLs (the proxy keeps Host). ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600
DOCKERIZED=1

# --- App server ---
DEBUG=0
GUNICORN_WORKERS=2

# --- Origins and URLs (everything is plain http behind 127.0.0.1:3300 and the Tailscale TCP forward) ---
# init-env keeps the existing apps/api/.env origins that end in :3300 (it warns unless there are exactly 4, and
# refuses without a non-local one, i.e. the MagicDNS host or tailnet IP).
# All must be http:// or the session/CSRF cookies become Secure and login breaks.
CORS_ALLOWED_ORIGINS=http://localhost:3300,http://127.0.0.1:3300,http://<PLANE_PUBLIC_HOST>:3300,http://<tailnet-ip>:3300
# WEB_URL also sets the MinIO custom domain used for export links and the links in emails.
WEB_URL=http://<tailnet-ip>:3300
APP_BASE_URL=http://<tailnet-ip>:3300
APP_BASE_PATH=
# Blank base URLs => <request origin>/god-mode/ and <request origin>/spaces/ (served by the release proxy).
ADMIN_BASE_URL=
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=
SPACE_BASE_PATH=/spaces
# Server-side only (worker -> live /convert-document/); browsers reach live through <origin>/live.
LIVE_BASE_URL=http://live:3000
LIVE_BASE_PATH=/live

# --- Misc (copied verbatim) ---
API_KEY_RATE_LIMIT=
HARD_DELETE_AFTER_DAYS=60
